# ===== 媒体产物不进 git（防止仓库膨胀）=====
# 项目工作区：只跟踪小文本（planning/、feedback-log.md、edit/edl.json、
# edit/master.srt），媒体一律忽略。
# 例外（v1 审核教训）：用户提供的文本原文（解说词/台词/拆解）必须入库，
# 否则"一字不改"无法审计
projects/*/input/**
!projects/*/input/**/
!projects/*/input/**/*.txt
!projects/*/input/**/*.md
!projects/*/input/**/*.json
projects/*/audio/
projects/*/preview/
projects/*/output/
projects/*/variants/
projects/*/edit/*
!projects/*/edit/edl.json
!projects/*/edit/master.srt
!projects/*/edit/project.md

# 通用素材库：索引进 git，素材本体不进（体积大；按 index.json 的
# source 字段可重新获取，或团队用网盘/LFS 同步）
library/memes/*
library/music/*
library/sfx/*
library/fonts/*
!library/*/.gitkeep

# 模板包只存文本配方（用户裁定：非通用素材一律跟随项目），
# 兜底拦截误放进模板包的媒体
templates/**/*.mp4
templates/**/*.mov
templates/**/*.wav
templates/**/*.webm

# ===== 运行时垃圾 =====
node_modules/
__pycache__/
*.pyc
.env
.DS_Store
