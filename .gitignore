# Video and media files (too large for git)
*.mp4
*.m4a
*.mp3
*.wav
*.aac

# But keep scripts and configs
!bin/

# Preview frames (images) - keep small ones, ignore large batches
bilingual-subtitle/projects/*/input/
bilingual-subtitle/projects/*/preview/
bilingual-subtitle/projects/*/output/*.mp4
bilingual-subtitle/projects/*/output/*.png
bilingual-subtitle/projects/*/audio/voice/
bilingual-subtitle/projects/*/audio/*.m4a

wechat-music-video/projects/*/input/
wechat-music-video/projects/*/output/*.mp4
wechat-music-video/projects/*/output/*.png
wechat-music-video/projects/*/audio/voice/
wechat-music-video/projects/*/audio/*.m4a
wechat-music-video/projects/*/input/gameplay/

# OS files
.DS_Store
*.pyc
__pycache__/

# Temp files
/tmp/
*.tmp

# Embedded git repos
wechat-dialog-generator/
wx_channels_download/

# OpenClaw internal
.openclaw/

# Misc temp files
clone.log
desktop-snapshot.png
voice_jarvis.py

# FFmpeg binaries (too large for git)
bin/ffmpeg
bin/ffprobe

